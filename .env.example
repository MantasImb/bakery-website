# Sentry runtime capture. Use the same value for both DSNs unless Sentry
# provides separate client and server DSNs for the project.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# Sentry environment and release labels. A production release should usually be
# the deployment git SHA or another stable deployment identifier.
SENTRY_ENVIRONMENT=development
NEXT_PUBLIC_SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=

# Source-map upload. Required only in CI or deployment jobs that upload source
# maps to Sentry.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# Developer-only smoke surface. Keep disabled unless intentionally verifying
# Sentry capture outside normal local development.
SENTRY_DEV_SMOKE_ENABLED=false
SENTRY_DEV_SMOKE_TOKEN=

# PostHog browser analytics. Leave the token empty to disable PostHog capture.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.posthog.com

# PostHog server analytics. Leave the key empty to disable server capture.
POSTHOG_PROJECT_API_KEY=
POSTHOG_HOST=https://eu.posthog.com
